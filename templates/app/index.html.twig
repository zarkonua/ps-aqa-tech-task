{% extends 'base.html.twig' %}

{% block title %}QA Task - Auth + Notes{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/styles.css') }}">
{% endblock %}

{% block body %}
    <main class="app-shell">
        <header class="page-head">
            <p class="kicker">Workspace</p>
            <h1>Notes Console</h1>
        </header>

        <p id="status" class="status" role="status" aria-live="polite"></p>

        <section id="auth-section" class="view-block">
            <div class="auth-grid">
                <article class="panel auth-card">
                    <h2>Sign Up</h2>
                    <form id="signup-form">
                        <label>Email <input type="email" id="signup-email" required></label>
                        <label>Password <input type="password" id="signup-password" minlength="8" required></label>
                        <button type="submit">Sign Up</button>
                    </form>
                    <small>Confirmation code is delivered via MailHog SMTP.</small>
                </article>

                <article class="panel auth-card">
                    <h2>Sign In</h2>
                    <form id="signin-form">
                        <label>Email <input type="email" id="signin-email" required></label>
                        <label>Password <input type="password" id="signin-password" required></label>
                        <button type="submit">Sign In</button>
                    </form>
                    <button id="forgot-password-button" class="link-button" type="button">Forgot password?</button>
                </article>

                <article id="forgot-password-card" class="panel auth-card hidden">
                    <h2>Forgot Password</h2>
                    <form id="forgot-password-form" novalidate>
                        <label>Email <input type="email" id="forgot-email" autocomplete="email" required></label>
                        <button type="submit">Send reset link</button>
                    </form>
                    <p id="forgot-feedback" class="share-feedback" role="alert"></p>
                    <small>The link is delivered via MailHog SMTP and is valid for 30 minutes.</small>
                </article>

                <article id="reset-password-card" class="panel auth-card hidden">
                    <h2>Reset Password</h2>
                    <form id="reset-password-form" novalidate>
                        <label>New password
                            <input type="password" id="reset-password" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="reset-hint">
                        </label>
                        <label>Repeat new password
                            <input type="password" id="reset-password-repeat" autocomplete="new-password" required>
                        </label>
                        <button type="submit">Set new password</button>
                    </form>
                    <p id="reset-feedback" class="share-feedback" role="alert"></p>
                    <button id="reset-request-new" class="secondary hidden" type="button">Request a new link</button>
                    <small id="reset-hint">12 to 128 characters.</small>
                </article>
            </div>
        </section>

        <section id="account-section" class="view-block hidden">
            <div class="account-header panel">
                <h2 id="account-title">Account</h2>
                <div class="account-actions">
                    <button id="nav-notes-button" class="secondary" type="button">Notes</button>
                    <button id="nav-shared-button" class="secondary" type="button">Shared with me</button>
                    <button id="nav-tags-button" class="secondary" type="button">Tags</button>
                    <button id="nav-profile-button" class="secondary" type="button">Profile</button>
                    <button id="logout-button" class="danger" type="button">Log Out</button>
                </div>
            </div>

            <div id="notes-view">
                <div id="notes-dashboard" class="dashboard-grid">
                    <section id="create-note-section" class="panel section-card">
                        <h2>Create</h2>
                        <form id="create-note-form">
                            <label>Title <input type="text" id="note-title" required></label>
                            <label>Content <textarea id="note-content" rows="7"></textarea></label>
                            <button type="submit">Create Note</button>
                        </form>
                    </section>

                    <section class="panel section-card">
                        <h2 id="notes-list-heading">List</h2>
                        <form id="search-notes-form" class="list-controls">
                            <label>Query <input type="text" id="notes-search-query" placeholder="Search notes"></label>
                            <label>Field
                                <select id="notes-search-field">
                                    <option value="all">Title + Content</option>
                                    <option value="title">Title only</option>
                                    <option value="content">Content only</option>
                                </select>
                            </label>
                            <label>Sort
                                <select id="notes-search-sort">
                                    <option value="updated_desc">Updated (newest first)</option>
                                    <option value="updated_asc">Updated (oldest first)</option>
                                    <option value="created_desc">Created (newest first)</option>
                                    <option value="created_asc">Created (oldest first)</option>
                                    <option value="title_asc">Title (A-Z)</option>
                                    <option value="title_desc">Title (Z-A)</option>
                                </select>
                            </label>
                            <label>Page Size
                                <select id="notes-page-size">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="20">20</option>
                                </select>
                            </label>
                            <label id="notes-tag-filter-label">Tag
                                <select id="notes-tag-filter">
                                    <option value="">All tags</option>
                                </select>
                            </label>
                            <label>Updated from <input type="date" id="notes-updated-from"></label>
                            <label>Updated to <input type="date" id="notes-updated-to"></label>
                        </form>

                        <div id="active-filters" class="active-filters hidden">
                            <ul id="active-filter-chips" class="chip-list" aria-label="Active filters"></ul>
                            <button id="notes-reset-filters" class="secondary" type="button">Reset all</button>
                        </div>

                        <div class="list-meta">
                            <span id="notes-list-total">0 notes</span>
                            <div class="pagination-controls">
                                <button id="notes-prev-page" class="secondary" type="button">Prev</button>
                                <span id="notes-page-info">Page 1 / 1</span>
                                <button id="notes-next-page" class="secondary" type="button">Next</button>
                            </div>
                        </div>

                        <div id="bulk-bar" class="bulk-bar">
                            <label class="color-toggle"><input type="checkbox" id="bulk-select-page"> Select page</label>
                            <span id="bulk-count" aria-live="polite">0 selected</span>
                            <div id="bulk-actions" class="bulk-actions hidden" role="group" aria-label="Actions for selected notes">
                                <label>Category for selected
                                    <select id="bulk-category"><option value="">No category</option></select>
                                </label>
                                <button id="bulk-set-category" class="secondary" type="button">Set category</button>
                                <label>Tag for selected
                                    <select id="bulk-tag"></select>
                                </label>
                                <button id="bulk-add-tag" class="secondary" type="button">Add tag</button>
                                <button id="bulk-remove-tag" class="secondary" type="button">Remove tag</button>
                                <button id="bulk-delete" class="danger" type="button">Delete selected</button>
                                <button id="bulk-clear" class="secondary" type="button">Clear selection</button>
                            </div>
                        </div>
                        <div id="bulk-report" class="panel notes-error hidden" role="status"></div>

                        <div id="notes-list" class="notes-list" aria-live="polite"></div>
                    </section>
                </div>
            </div>

            <div id="taxonomy-view" class="hidden">
                <div class="dashboard-grid taxonomy-grid">
                    {% for kind in [
                        {key: 'tags', title: 'Tags', one: 'tag'},
                        {key: 'categories', title: 'Categories', one: 'category'},
                    ] %}
                        <section class="panel section-card" data-taxonomy="{{ kind.key }}" data-one="{{ kind.one }}">
                            <h2>{{ kind.title }}</h2>
                            <form class="taxonomy-form" novalidate>
                                <label>New {{ kind.one }} name
                                    <input type="text" name="name" maxlength="30" autocomplete="off" required>
                                </label>
                                <label class="color-toggle"><input type="checkbox" name="use-color"> Color</label>
                                <label class="color-input">{{ kind.title }} color
                                    <input type="color" name="color" value="#b8743f" disabled>
                                </label>
                                <button type="submit">Add {{ kind.one }}</button>
                            </form>
                            <p class="share-feedback" role="alert"></p>
                            <div class="taxonomy-list" aria-live="polite"></div>
                        </section>
                    {% endfor %}
                </div>
            </div>

            <div id="profile-view" class="hidden">
                <div class="dashboard-grid taxonomy-grid">
                    <div class="panel profile-card">
                        <h2>Profile</h2>
                        <p><strong>Email:</strong> <span id="profile-email">-</span></p>
                        <p id="profile-pending" class="share-empty hidden">Waiting for confirmation of <strong id="profile-pending-email"></strong>. Open the link sent to that address.</p>
                        <p><strong>User ID:</strong> <span id="profile-id">-</span></p>

                        <h3>Change email</h3>
                        <form id="change-email-form" class="modal-form" novalidate>
                            <label>New email <input type="email" id="change-email-new" autocomplete="email" maxlength="190" required></label>
                            <label>Current password <input type="password" id="change-email-password" autocomplete="current-password" required></label>
                            <button type="submit">Send confirmation link</button>
                        </form>
                        <p id="change-email-feedback" class="share-feedback" role="alert"></p>
                    </div>

                    <div class="panel profile-card">
                        <h2>Settings</h2>
                        <form id="settings-form" class="modal-form" novalidate>
                            <label>Time zone
                                <select id="settings-timezone"></select>
                            </label>
                            <button type="submit">Save settings</button>
                        </form>
                        <p id="settings-feedback" class="share-feedback" role="alert" aria-live="polite"></p>

                        <h3>Password</h3>
                        <p class="share-empty">Changing the password signs you out on every other device.</p>
                        <button id="change-password-button" class="secondary" type="button">Change password</button>
                    </div>
                </div>
            </div>
        </section>

    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/app.js') }}" defer></script>
{% endblock %}
